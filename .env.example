# Jarvis environment -- copy to .env and fill in. Every key is optional;
# features degrade in scope, never crash, when one is missing.

# --- Speech-to-text tiers ---
# Moonshine is the fully-offline, open-vocabulary tier. Setting this to 1
# puts it FIRST in the chain: hearing becomes local and private, with the
# cloud tiers as backups. The model (a few hundred MB) downloads automatically
# on first use. Leave unset for the classic Gemini -> OpenRouter -> Vosk chain.
# JARVIS_STT_LOCAL_FIRST=1

# Smaller/faster Moonshine model (tiny, base, tiny_streaming,
# base_streaming, small_streaming, medium_streaming). Default: medium_streaming.
# MOONSHINE_COMPRESSION=small_streaming

GEMINI_API_KEY=
OPENROUTER_STT_API_KEY=
OPENROUTER_API_KEY=

# --- Command router / chat / TTS on Groq ---
GROQ_API_KEY=
GROQ_TTS_API_KEY=

# --- Behaviour ---
# JARVIS_NO_UI=1              # force the terminal UI off
# JARVIS_NO_TYPING=1          # disable typed input
# JARVIS_TTS_LOCAL_FIRST=1    # prefer local TTS: Moonshine -> Kokoro ->
#                             #   cloud (Groq/Orpheus). Audio plays straight
#                             #   from the TTS with no time-stretch/tweaking.
# MOONSHINE_VOICE=kokoro_af_sky  # Moonshine TTS voice (kokoro_*, piper_*,
#                             #   zipvoice_*); default kokoro_af_sky.

# DEV_LOG=1                 # detailed machine log (dev_log.txt) -- every STT/
#                           # TTS/thinking/action event with timings, aligned
#                           # columns. Off by default; log.txt is always on.