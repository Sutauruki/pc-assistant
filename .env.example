# Jarvis environment -- copy to .env and fill in. Every key is optional;
# features degrade in scope, never crash, when one is missing.

# --- Speech-to-text ---
# Moonshine is the only STT tier: fully offline, open-vocabulary. The model
# (a few hundred MB) downloads automatically on first use.

# Smaller/faster Moonshine model (tiny, base, tiny_streaming,
# base_streaming, small_streaming, medium_streaming). Default: medium_streaming.
# MOONSHINE_COMPRESSION=small_streaming

# --- Text-to-speech ---
# Fish Audio S2.1 Pro is the primary voice (free developer tier, fair use,
# no SLA). Get a key at https://fish.audio/app/api-keys. Without a key -- or
# if Fish fails, rate-limits, or the free tier ends -- Jarvis falls back to
# the offline Moonshine voice automatically.
FISH_API_KEY=
# FISH_VOICE_ID=              # voice model id from fish.audio (reference_id);
#                             #   unset uses Fish's default voice
# FISH_MODEL=s2.1-pro-free    # model header; s2.1-pro for the paid tier
# FISH_VOLUME_DB=3            # louder (+) or quieter (-), in dB; Fish applies it
# FISH_SAMPLE_RATE=44100     # 44100 (best, Fish's native) | 32000 | 24000 |
#                             #   16000 | 8000 -- lower only to save data
# FISH_LATENCY=balanced      # low | normal | balanced; low starts talking
#                             #   sooner, slightly lower voice quality
# FISH_CACHE=0               # turn off the on-disk cache of short replies
#                             #   (cache/tts_fish/; on by default)

# Speech-to-text: Groq Whisper (fast, accurate) with Moonshine as the offline
# fallback. A SEPARATE Groq key from GROQ_API_KEY, so hearing and command
# parsing use different limits. Unset = Moonshine only (nothing leaves the PC).
GROQ_TTS_API_KEY=
# MIC_SENSITIVITY=1.0         # higher hears quieter speech (1.5 soft voice/far
#                             #   mic); lower ignores more noise (0.7 loud room)
# RECORD_SILENCE_SECONDS=1.2  # pause that ends a recording; raise if it cuts
#                             #   you off, lower for snappier replies
# STT_ENGINE=moonshine         # force offline hearing even with a key
# GROQ_STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en              # blank to auto-detect

# --- Screen understanding (commands/screen_actions.py) ---
GEMINI_API_KEY=

# Extra words that mark a window as private (comma-separated): never
# screenshotted, never touched. Password managers and banking are built in.
# JARVIS_SENSITIVE=gtbank,opay,my broker
# SCREEN_THINKING=minimal     # minimal | low | medium | high

# --- Computer control (commands/agent.py) ---
# Uses GEMINI_API_KEY (and GROQ_API_KEY for the fast on-task safety check).
# AGENT_MAX_STEPS=30
# AGENT_TIMEOUT=300           # seconds
# AGENT_THINKING=low

# --- Command parser / chat brain ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Behaviour ---
# MOONSHINE_VOICE=kokoro_af_bella  # fallback Moonshine TTS voice (kokoro_*, piper_*,
#                             #   zipvoice_*); default kokoro_af_bella.

# JARVIS_NO_WINDOW=1          # don't open the small desktop window
# JARVIS_NO_UI=1              # force the terminal UI off
# JARVIS_NO_TYPING=1          # disable typed input

# DEV_LOG=1                 # detailed machine log (dev_log.txt) -- every STT/
#                           # TTS/thinking/action event with timings, aligned
#                           # columns. Off by default; log.txt is always on.
